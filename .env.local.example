# Public browser configuration for Cloudflare Pages + Render API:
# VITE_DEEPSEEK_PROXY_URL=https://your-render-service.onrender.com/api/deepseek/chat

# Shared site AI (off by default; v1 production ships without it). The proxy only calls the
# provider when SITE_AI_ENABLED=true AND a key is set. Personal AI services and the ChatGPT bridge
# work without any of this. Never prefix the key with VITE_.
# SITE_AI_ENABLED=true
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-v4-flash
# AI_MAX_OUTPUT_TOKENS=4000
# The larger default accommodates a complete archive prompt.
# AI_TIMEOUT_MS=45000
# Optional when the frontend is hosted on another origin (for example Cloudflare Pages).
# CORS_ORIGIN=https://your-pages-domain.pages.dev

# Optional shared AI quota for multi-instance deployments (Upstash Redis REST API).
# AI_QUOTA_REDIS_URL=https://your-database.upstash.io
# AI_QUOTA_REDIS_TOKEN=your_upstash_rest_token
# AI_QUOTA_FAIL_CLOSED=true
# AI_QUOTA_TIMEOUT_MS=2000
# AI_GLOBAL_RATE_LIMIT_PER_MINUTE=100
# AI_GLOBAL_RATE_LIMIT_PER_DAY=10000

# AI proxy origin and client-IP handling (see docs/deployment.md before enabling in production).
# AI_REQUIRE_ORIGIN defaults to true when NODE_ENV=production.
# AI_REQUIRE_ORIGIN=true
# Number of trusted reverse proxies appending to X-Forwarded-For (read from the right).
# TRUST_PROXY=1
# Or a single-value header overwritten by a trusted edge; verify it cannot be spoofed first.
# CLIENT_IP_HEADER=cf-connecting-ip
